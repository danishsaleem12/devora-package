PORT=5000
# One or more allowed frontend origins, comma-separated (no trailing slash)
FRONTEND_URL=http://localhost:3000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/devora
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=use-a-long-random-password
JWT_SECRET=use-a-long-random-string-64-chars

# ---- Email (optional: without these, emails are skipped and only logged) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
# Sender shown to recipients (defaults to SMTP_USER)
MAIL_FROM="Devora <you@gmail.com>"
# Where "new contact message / new application" alerts are sent
ADMIN_NOTIFY_EMAIL=you@gmail.com
# Press contact shown on the News & Media page (optional)
PRESS_EMAIL=
